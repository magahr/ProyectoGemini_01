# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# Common Node.js ignores
node_modules/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.log
*.tmp
*.swp
.idea/
.vscode/

# Backend (NestJS) specific ignores
/bookstore-api/dist/
/bookstore-api/coverage/
/bookstore-api/*.tsbuildinfo

# Frontend (Next.js) specific ignores
/bookstores-frontend-next/.next/
/bookstores-frontend-next/out/ # For static exports
/bookstores-frontend-next/coverage/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
